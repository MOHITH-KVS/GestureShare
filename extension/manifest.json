{
  "manifest_version": 3,
  "name": "GestureShare",
  "version": "0.1.0",
  "description": "Transfer files between devices using hand gestures.",
  "action": {
    "default_title": "Open GestureShare"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
