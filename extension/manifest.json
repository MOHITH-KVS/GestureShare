{
  "manifest_version": 3,
  "name": "GestureShare",
  "version": "0.9.1",
  "description": "Transfer files between devices using hand gestures.",
  "action": {
    "default_title": "Open GestureShare",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "camera.html"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "offscreen",
    "downloads",
    "notifications",
    "contextMenus"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}