{
  "manifest_version": 3,
  "name": "GestureShare",
  "version": "0.6.0",
  "description": "Transfer files between devices using hand gestures.",
  "action": {
    "default_title": "Open GestureShare"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "camera.html"
  },
  "permissions": ["storage", "sidePanel"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
